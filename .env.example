# =====================================================================
# UtsavAI environment variables. Placeholders only: never commit real values.
# Backend: apps/api/.env   Frontend: apps/web/.env.local
# Use separate Supabase projects and credentials for dev, test and production.
# =====================================================================

# ------------------------------ BACKEND (apps/api/.env) ---------------
APP_ENV=development                      # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
ENABLE_DOCS=                             # blank = on outside production

# Runtime role connection (role: utsavai_app, NOBYPASSRLS). NEVER postgres or a service-role key.
# Supabase pooler form: postgresql://utsavai_app.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
DATABASE_URL=postgresql://utsavai_app:CHANGE_ME@localhost:5432/utsavai
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000

# Supabase Auth (JWT verification). Issuer and JWKS URL are derived from SUPABASE_URL when blank.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=                     # legacy HS256 projects only; leave blank for JWKS
JWT_LEEWAY_SECONDS=10

# Comma-separated explicit origins (https only in production). Never "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------ FRONTEND (apps/web/.env.local) --------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
NEXT_PUBLIC_APP_ENV=development
API_BASE_URL=http://localhost:8000       # server-side only; the browser never sees it
BFF_ALLOWED_ORIGINS=                     # extra origins allowed to call the BFF (optional)
BACKEND_TIMEOUT_MS=15000

# ------------------------------ TEST ONLY ------------------------------
# Used by pytest integration tests and scripts/setup_local_db.sh against a LOCAL database.
TEST_DATABASE_ADMIN_URL=postgresql://postgres:LOCAL_ONLY@localhost:5432/utsavai_test
TEST_DATABASE_URL=postgresql://utsavai_app:LOCAL_ONLY@localhost:5432/utsavai_test
E2E_BASE_URL=http://localhost:3000

# Gemini is intentionally absent: AI integration starts in a later phase.
